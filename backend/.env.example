# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.

# ---- Application ----
PROJECT_NAME="Student Clearance Management System"
ENVIRONMENT=development
DEBUG=true

# ---- Database ----
# Stored as separate parts, not as one URL. The application URL-encodes the
# password itself, so special characters such as @ : / ? # need no escaping here.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clearance

# ---- Security ----
# Generate with:  py -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_me_with_a_generated_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Comma-separated exact origins. Never use "*" together with credentials.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880
